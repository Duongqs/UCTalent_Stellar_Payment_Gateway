	"item": [
		{
			"name": "Bank Transfer Create",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function makeInvoiceNo() {\r",
							"    var timestamp = new Date().getTime();\r",
							"    var random = randomIntFromInterval(0, 999999);\r",
							"    var invoiceNo = timestamp + random;\r",
							"    return invoiceNo.toString().slice(0,10);\r",
							"}\r",
							"function randomIntFromInterval(min, max) { // min and max included \r",
							"  return Math.floor(Math.random() * (max - min + 1) + min)\r",
							"}\r",
							"function getInvoiceNo(length) {\r",
							"    let result = '';\r",
							"    let characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\r",
							"    let charactersLength = characters.length;\r",
							"    for (let i = 0; i < length; i++) {\r",
							"        result += characters.charAt(Math.floor(Math.random() * charactersLength));\r",
							"    }\r",
							"    return result;\r",
							"}\r",
							"function buildHttpQuery(params) {\r",
							"    var queryString = Object.keys(params).sort().map((key) => {\r",
							"    return encodeURIComponent(key) + '=' + encodeURIComponent(params[key])\r",
							"    }).join('&');\r",
							"    console.log(queryString.replace(/%20/g, \"+\"));\r",
							"    return queryString.replace(/%20/g, \"+\");\r",
							"}\r",
							"function base64url(source) {\r",
							"    // Encode in classical base64\r",
							"    encodedSource = CryptoJS.enc.Base64.stringify(source)\r",
							"    \r",
							"    // Remove padding equal characters\r",
							"    encodedSource = encodedSource.replace(/=+$/, '')\r",
							"    \r",
							"    // Replace characters according to base64url specifications\r",
							"    encodedSource = encodedSource.replace(/\\+/g, '-')\r",
							"    encodedSource = encodedSource.replace(/\\//g, '_')\r",
							"    \r",
							"    return encodedSource\r",
							"}\r",
							"function buildSignature(data, secret) {\r",
							"    var signature = CryptoJS.HmacSHA256(data, secret)\r",
							"    signature = CryptoJS.enc.Base64.stringify(signature)\r",
							"    return signature;\r",
							"}\r",
							"\r",
							"const MERCHANT_KEY = pm.variables.get(\"client_id\");\r",
							"const MERCHANT_SECRET_KEY = pm.variables.get(\"secret_key\");\r",
							"const END_POINT = pm.variables.get(\"portal_domain\");\r",
							"\r",
							"var time = Math.round(Date.now() / 1000);\r",
							"//var invoiceNo = getInvoiceNo(8);\r",
							"var invoiceNo =pm.request.body.formdata.get('invoice_no');\r",
							"var amount = pm.request.body.formdata.get('amount'); // This value is better than 3000 VND. We only use currency is \"VND\"\r",
							"var description = pm.request.body.formdata.get('description');\r",
							"var returnUrl = pm.request.body.formdata.get('return_url');\r",
							"var method = pm.request.body.formdata.get('method');\r",
							"var expires_time = pm.request.body.formdata.get('expires_time');\r",
							"var currency = pm.request.body.formdata.get('currency');\r",
							"var parameters = {\r",
							"    \"merchantKey\": MERCHANT_KEY,\r",
							"    \"time\": time,\r",
							"    \"invoice_no\": invoiceNo,  \r",
							"    \"lang\": pm.request.body.formdata.get('lang'),\r",
							"    \"client_ip\": pm.request.body.formdata.get('client_ip'),\r",
							"    \"amount\": amount,\r",
							"    \"currency\": currency,\r",
							"    \"method\": method,\r",
							"    \"description\": description,\r",
							"    \"return_url\": returnUrl,\r",
							"    \"expires_time\": expires_time\r",
							"};\r",
							"var httpQuery = buildHttpQuery(parameters);\r",
							"//var httpQuery = '';\r",
							"var message = \"POST\" + \"\\n\" + END_POINT + \"/api/payments/create-bank-transfer\" + \"\\n\" + time + \"\\n\" + httpQuery;\r",
							"console.log(message);\r",
							"var signature = buildSignature(message, MERCHANT_SECRET_KEY);\r",
							"console.log('Sign:' + signature);\r",
							"//var invoiceNo = makeInvoiceNo();\r",
							"postman.setEnvironmentVariable('invoiceNo', invoiceNo);\r",
							"postman.setEnvironmentVariable('client_id', MERCHANT_KEY);\r",
							"postman.setEnvironmentVariable('time', time);\r",
							"postman.setEnvironmentVariable('signature', signature);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
