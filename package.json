{
  "name": "uc-cross-border-monorepo",
  "version": "1.0.0",
  "description": "NestJS TypeScript Monorepo for Stellar Cross-Border Disbursements",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start:api": "npm run start:dev -w @uc/api",
    "start:worker": "npm run start:dev -w @uc/worker",
    "db:seed": "node packages/core/dist/demo/demo-seed.js",
    "db:reset": "node packages/core/dist/demo/demo-reset.js",
    "db:migrate": "node packages/core/dist/demo/migrate-sqlite.js"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
