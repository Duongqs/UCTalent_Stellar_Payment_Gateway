# UC Talent Disbursement Bridge — Env Example
# Copy to .env and fill in values
# ================================================

# ── Soroban Testnet ──────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=

# ── SEP-31 Anchor ────────────────────────────────────────────────────────────
ANCHOR_PORT=4000
ANCHOR_DOMAIN=localhost:4000
SEP31_WEBHOOK_URL=http://localhost:4000/api/anchor/disburse
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ANCHOR_SIGNING_KEY=
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Platform Treasury ─────────────────────────────────────────────────────────
PLATFORM_TREASURY_ADDRESS=
PLATFORM_BANK_CODE=BIDV
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=UCTALENT PLATFORM

# ── Exchange Rate Oracle ──────────────────────────────────────────────────────
ORACLE_SOURCES=binance_p2p,coingecko,vcb_rate
ORACLE_MODE=mock
ORACLE_CACHE_TTL_MS=900000
ORACLE_HARD_BOUND_MIN=23000
ORACLE_HARD_BOUND_MAX=26500
ORACLE_SAFETY_SPREAD=0.99
ORACLE_FALLBACK_RATE=25450
BINANCE_API_KEY=
COINGECKO_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=uctalent
POSTGRES_PASSWORD=password
POSTGRES_DB=uctalent_dev

# ── Security ──────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change-in-production
KYC_SALT=uctalent-salt-2026
ALLOWED_WEBHOOK_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# ── Token precision ──────────────────────────────────────────────────────────
TOKEN_DECIMALS=7
POLL_INTERVAL_MS=5000

# ── 9Pay Disbursement Integration (Sandbox) ──────────────────────────────────
NINEPAY_BASE_URL=https://sand-payment.9pay.vn
NINEPAY_MERCHANT_KEY=
NINEPAY_SECRET_KEY=
NINEPAY_CHECKSUM_KEY=

# ── UCTalent Backend Callback ─────────────────────────────────────────────────
UCTALENT_BACKEND_WEBHOOK_URL=http://localhost:3000/api/v2/cross-border/settlement-callback
UCTALENT_BACKEND_INTERNAL_URL=http://localhost:3000
INTERNAL_API_TOKEN=
