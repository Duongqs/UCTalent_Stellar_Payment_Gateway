# UC Stellar / Cross-Border — Env Example
# Source of truth for runtime validation: packages/core/src/config/env.config.ts
# Copy to .env and fill in values.
# ================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=local
PORT=8081

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_USER=uct_rails_dev_root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uct_cross_border_dev
POSTGRES_DB_TEST=uct_cross_border_dev_test

# ── Soroban / Stellar ─────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
USDC_ISSUER=your-usdc-issuer-address
TOKEN_DECIMALS=7
ESCROW_CONTRACT_ID=
FUNDING_SECRET=
ANCHOR_SIGNING_KEY=

# ── Anchor platform (internal Docker DNS on VPS) ────────────────────────────
ANCHOR_PLATFORM_URL=http://localhost:8082
PLATFORM_SERVER_URL=http://localhost:8085

# ── 9Pay ──────────────────────────────────────────────────────────────────────
NINEPAY_API_URL=https://sand-payment.9pay.vn
NINEPAY_MODE=live
NINEPAY_MERCHANT_KEY=
NINEPAY_SECRET_KEY=
NINEPAY_CHECKSUM_KEY=

# ── Platform treasury (PIT) ───────────────────────────────────────────────────
PIT_BANK_CODE=BIDV
PIT_ACCOUNT_NUMBER=96311300000170179
PIT_ACCOUNT_NAME=UCTALENT PLATFORM

# ── Oracle ────────────────────────────────────────────────────────────────────
ORACLE_HARD_BOUND_MIN=23000
ORACLE_HARD_BOUND_MAX=28000
ORACLE_SAFETY_SPREAD=0.99
ORACLE_CACHE_TTL_MS=900000

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Dev public (./log): https://cb-api.dev.uctalent.io , https://anchor.dev.uctalent.io
UCTALENT_BACKEND_WEBHOOK_URL=http://localhost:3000/api/v2/cross-border/settlement-callback
SEP31_WEBHOOK_URL=http://localhost:8081/api/anchor/disburse
WEBHOOK_SECRET=uctalent-dev-secret
CROSS_BORDER_WEBHOOK_SECRET=uctalent-dev-secret
ALLOWED_WEBHOOK_IPS=127.0.0.1,::1,*
USE_MOCK_IPN=true
KYC_SALT=uctalent-salt-2026

# ── Security ──────────────────────────────────────────────────────────────────
# Min 32 characters each
ENCRYPTION_SECRET=a_very_secure_secret_key_that_is_at_least_32_bytes_long!
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_bytes_long!

# ── Database migrations (scripts/migrations/*.sql on API boot) ────────────────
AUTO_RUN_MIGRATIONS=true

# ── Worker polling ────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=5000
PROCESS_INTERVAL_MS=2000

# ── Optional ──────────────────────────────────────────────────────────────────
SLACK_ALERT_WEBHOOK=
PIT_BANK_CODE=
PIT_ACCOUNT_NUMBER=
PIT_ACCOUNT_NAME=
USE_MOCK_NINEPAY=
USE_MOCK_IPN=
