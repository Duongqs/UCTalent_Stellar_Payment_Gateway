# UC Cross-Border Bridge (New) — Env Example
# Copy to .env and fill in values
# ================================================

# ── Soroban Testnet ──────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
ESCROW_CONTRACT_ID=CB5XDGAX6FX4NYARD36YNIHUWBAFNSYPH64ZM7INOWM735UMFFKY35GZ

# ── SEP-31 Anchor ────────────────────────────────────────────────────────────
ANCHOR_PORT=4001
ANCHOR_DOMAIN=localhost:4001
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ANCHOR_SIGNING_KEY=
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── Platform Treasury ─────────────────────────────────────────────────────────
PLATFORM_TREASURY_ADDRESS=
PLATFORM_BANK_CODE=BIDV
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=UCTALENT PLATFORM

# ── Exchange Rate Oracle ──────────────────────────────────────────────────────
ORACLE_SOURCES=binance_p2p,coingecko,vcb_rate
ORACLE_MODE=mock
ORACLE_CACHE_TTL_MS=900000
ORACLE_HARD_BOUND_MIN=23000
ORACLE_HARD_BOUND_MAX=26500
ORACLE_SAFETY_SPREAD=0.99
ORACLE_FALLBACK_RATE=25450
BINANCE_API_KEY=
COINGECKO_API_KEY=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uct_cross_border_dev

# ── Redis (for BullMQ retry worker) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend Connection ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3000
CROSS_BORDER_INTERNAL_TOKEN=your-internal-token
CROSS_BORDER_PRIVATE_RSA_KEY=-----BEGIN RSA PRIVATE KEY-----\n...

# ── Security ──────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change-in-production
KYC_SALT=uctalent-salt-2026

# ── 9Pay ──────────────────────────────────────────────────────────────────────
NINEPAY_API_URL=https://sand-payment.9pay.vn
NINEPAY_MERCHANT_ID=wuuFRU
NINEPAY_SECRET_KEY=
