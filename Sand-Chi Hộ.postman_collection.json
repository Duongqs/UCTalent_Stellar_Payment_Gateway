	"item": [
		{
			"name": "Kiểm tra tài khoản nhận tiền",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function makeInvoiceNo() {",
							"    var timestamp = new Date().getTime();",
							"    var random = randomIntFromInterval(0, 999999);",
							"    var invoiceNo = timestamp + random;",
							"    return invoiceNo.toString().slice(0,10);",
							"}",
							"function randomIntFromInterval(min, max) { // min and max included ",
							"  return Math.floor(Math.random() * (max - min + 1) + min)",
							"}",
							"function getInvoiceNo(length) {",
							"    let result = '';",
							"    let characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';",
							"    let charactersLength = characters.length;",
							"    for (let i = 0; i < length; i++) {",
							"        result += characters.charAt(Math.floor(Math.random() * charactersLength));",
							"    }",
							"    return result;",
							"}",
							"function buildHttpQuery(params) {",
							"    var queryString = Object.keys(params).sort().map((key) => {",
							"    return encodeURIComponent(key) + '=' + encodeURIComponent(params[key])",
							"    }).join('&');",
							"    console.log(queryString.replace(/%20/g, \"+\"));",
							"    return queryString.replace(/%20/g, \"+\");",
							"}",
							"function base64url(source) {",
							"    // Encode in classical base64",
							"    encodedSource = CryptoJS.enc.Base64.stringify(source)",
							"    ",
							"    // Remove padding equal characters",
							"    encodedSource = encodedSource.replace(/=+$/, '')",
							"    ",
							"    // Replace characters according to base64url specifications",
							"    encodedSource = encodedSource.replace(/\\+/g, '-')",
							"    encodedSource = encodedSource.replace(/\\//g, '_')",
							"    ",
							"    return encodedSource",
							"}",
							"function buildSignature(data, secret) {",
							"    var signature = CryptoJS.HmacSHA256(data, secret)",
							"    signature = CryptoJS.enc.Base64.stringify(signature)",
							"    return signature;",
							"}",
							"",
							"const MERCHANT_KEY = pm.variables.get(\"client_id\");",
							"const MERCHANT_SECRET_KEY = pm.variables.get(\"secret_key\");",
							"const END_POINT = pm.variables.get(\"portal_domain\");",
							"",
							"var time = Math.round(Date.now() / 1000);",
							"var invoiceNo = getInvoiceNo(8);",
							"var request_id = pm.request.body.formdata.get('request_id'); // This value is better than 3000 VND. We only use currency is \"VND\"",
							"var bank_code = pm.request.body.formdata.get('bank_code');",
							"var account_no = pm.request.body.formdata.get('account_no');",
							"var account_type = pm.request.body.formdata.get('account_type');",
							"var parameters = {",
							"    \"request_id\": request_id,",
							"    \"bank_code\": bank_code,  ",
							"    \"account_no\": account_no,",
							"    \"account_type\": account_type",
							"};",
							"var httpQuery = buildHttpQuery(parameters);",
							"//var httpQuery = '';",
							"var message = \"POST\" + \"\\n\" + END_POINT + \"/disbursement/check-account\" + \"\\n\" + time + \"\\n\" + httpQuery;",
							"console.log(message);",
							"var signature = buildSignature(message, MERCHANT_SECRET_KEY);",
							"console.log('Sign:' + signature);",
							"//var invoiceNo = makeInvoiceNo();",
							"postman.setEnvironmentVariable('invoiceNo', invoiceNo);",
							"postman.setEnvironmentVariable('client_id', MERCHANT_KEY);",
							"postman.setEnvironmentVariable('time', time);",
							"postman.setEnvironmentVariable('signature', signature);",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Signature Algorithm=HS256,Credential={{client_id}},SignedHeaders=,Signature={{signature}}",
						"type": "text"
					},
					{
						"key": "Date",
						"value": "{{time}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "request_id",
							"value": "1996359677",
							"type": "text"
						},
						{
							"key": "bank_code",
							"value": "9PAY",
							"type": "text"
						},
						{
							"key": "account_no",
							"value": "0888523111",
							"type": "text"
						},
						{
							"key": "account_type",
							"value": "0",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{portal_domain}}/disbursement/check-account",
					"host": [
						"{{portal_domain}}"
					],
					"path": [
						"disbursement",
						"check-account"
					]
				}
			},
			"response": []
